# ---------------------------------------------------------------------------
# Database: Supabase (PostgreSQL)
# Supabase Dashboard > Project Settings > Database > Connection string
# DATABASE_URL: "Transaction pooler" (port 6543) with ?pgbouncer=true&connection_limit=1
# DIRECT_URL:   "Session pooler" or direct connection (port 5432), used by prisma db push
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Supabase Storage (property photo uploads)
# Supabase Dashboard > Project Settings > API. The service role key is SECRET:
# it is only used on the server, never sent to the browser.
# ---------------------------------------------------------------------------
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="property-images"
# Private bucket for KYC / agreements (created automatically, never public)
SUPABASE_DOCUMENTS_BUCKET="documents"

# Secret used to sign login sessions. Generate one with: openssl rand -base64 32
AUTH_SECRET="change-this-to-a-long-random-string"

# Public URL of the app (used in email links). No trailing slash.
APP_URL="https://crm.yourcompany.com"

# Business timezone: all dates, "today" and reminders use this zone
APP_TIMEZONE="Asia/Kolkata"

# ---------------------------------------------------------------------------
# Web push notifications (follow-up reminders on desktop and mobile)
# Generate with: npm run vapid
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@yourcompany.com"

# ---------------------------------------------------------------------------
# Email (SMTP) for daily digest and password reset
# Gmail: smtp.gmail.com / 465 with an App Password. Brevo, Zoho, Resend SMTP also work.
# ---------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="EstateDesk CRM <no-reply@yourcompany.com>"

# ---------------------------------------------------------------------------
# Scheduled reminders: /api/cron/reminders must be called every 5 minutes
# with header "Authorization: Bearer <CRON_SECRET>". See docs/SUPABASE_CRON.sql.
# Generate with: openssl rand -hex 24
# ---------------------------------------------------------------------------
CRON_SECRET=""

# ---------------------------------------------------------------------------
# SaaS: your product brand (shown on the marketing site, app, emails, invoices)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="EstateDesk"
NEXT_PUBLIC_APP_TAGLINE="The real estate CRM that helps you follow up faster and close more deals"
NEXT_PUBLIC_SITE_URL="https://yourcrm.com"
NEXT_PUBLIC_SUPPORT_EMAIL="support@yourcrm.com"
NEXT_PUBLIC_SUPPORT_PHONE="+91 90000 00000"
# Your registered business details (legal pages show a "template" note until NEXT_PUBLIC_LEGAL_NAME is set)
NEXT_PUBLIC_LEGAL_NAME="Your Company Pvt Ltd"
NEXT_PUBLIC_LEGAL_ADDRESS="Full registered address"
NEXT_PUBLIC_GSTIN=""

# Platform owner: these emails can open /admin (comma separated)
SUPER_ADMIN_EMAILS="you@yourcrm.com"
# Free trial for new sign-ups
TRIAL_DAYS="14"
TRIAL_PLAN_CODE="GROWTH"

# ---------------------------------------------------------------------------
# Subscription billing (Razorpay). Without these, the billing page asks customers
# to contact you, and you activate plans manually from /admin.
# Dashboard > Settings > API Keys / Webhooks. Webhook URL: https://yourcrm.com/api/webhooks/razorpay
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Seller details printed on GST tax invoices
PLATFORM_LEGAL_NAME="Your Company Pvt Ltd"
PLATFORM_GSTIN=""
PLATFORM_ADDRESS="Full registered address"
PLATFORM_STATE="Maharashtra"
PLATFORM_SUPPORT_EMAIL="billing@yourcrm.com"
PLATFORM_SUPPORT_PHONE="+91 90000 00000"
