{
  "name": "estatedesk-crm",
  "version": "1.0.0",
  "private": true,
  "description": "EstateDesk - Real Estate CRM to manage leads, properties, follow-ups and close more deals",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx scripts/secure-db.ts && tsx prisma/seed.ts",
    "db:secure": "tsx scripts/secure-db.ts",
    "setup": "prisma db push && tsx scripts/secure-db.ts && tsx prisma/seed.ts",
    "setup:empty": "prisma db push && tsx scripts/secure-db.ts",
    "postinstall": "prisma generate",
    "vapid": "node scripts/generate-vapid.mjs",
    "test": "vitest run",
    "test:isolation": "tsx scripts/check-isolation.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@prisma/client": "^6.19.3",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/supabase-js": "^2.118.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jose": "^6.2.14",
    "lucide-react": "^1.66.0",
    "next": "^16.4.3",
    "nodemailer": "^10.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^5.0.5"
  }
}
