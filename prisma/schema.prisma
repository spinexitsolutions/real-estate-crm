// EstateDesk CRM database schema (PostgreSQL / Supabase)
// DATABASE_URL -> Supabase pooled connection (port 6543, ?pgbouncer=true)
// DIRECT_URL   -> Supabase direct connection (port 5432), used for migrations

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  password    String
  phone       String?
  role        String   @default("AGENT") // ADMIN | MANAGER | AGENT
  active      Boolean  @default(true)
  monthlyTarget Float  @default(0)
  notifyEmail    Boolean @default(true)
  notifyPush     Boolean @default(true)
  notifyWhatsApp Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignedLeads   Lead[]     @relation("LeadAssignee")
  createdLeads    Lead[]     @relation("LeadCreator")
  properties      Property[]
  followUps       FollowUp[]
  activities      Activity[]
  deals           Deal[]
  messages        WhatsAppMessage[]
  pushSubscriptions PushSubscription[]
  resetTokens     PasswordResetToken[]
  calls           CallLog[]
  attendance      Attendance[]
  siteCheckIns    SiteVisitCheckIn[]
  documents       Document[]          @relation("DocumentUploader")
  bookingsCreated Booking[]           @relation("BookingCreator")
  paymentsRecorded Payment[]         @relation("PaymentRecorder")
  paymentsCancelled Payment[]        @relation("PaymentCanceller")
}

model Lead {
  id                String    @id @default(cuid())
  name              String
  phone             String
  alternatePhone    String?
  email             String?
  source            String    @default("WEBSITE")
  status            String    @default("NEW")
  priority          String    @default("WARM") // HOT | WARM | COLD
  purpose           String    @default("BUY") // BUY | RENT | INVEST
  propertyType      String?
  preferredLocation String?
  bedrooms          Int?
  budgetMin         Float?
  budgetMax         Float?
  notes             String?
  tags              String    @default("")
  lostReason        String?
  lastContactedAt   DateTime?
  lastInboundAt     DateTime?
  unreadMessages    Int       @default(0)
  assignedToId      String?
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  assignedTo  User?             @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy   User?             @relation("LeadCreator", fields: [createdById], references: [id], onDelete: SetNull)
  followUps   FollowUp[]
  activities  Activity[]
  deals       Deal[]
  interests   LeadProperty[]
  messages    WhatsAppMessage[]
  bookings    Booking[]
  calls       CallLog[]
  documents   Document[]
  checkIns    SiteVisitCheckIn[]
  portalAccess PortalAccess?

  @@index([status])
  @@index([assignedToId])
  @@index([createdAt])
}

model Property {
  id           String   @id @default(cuid())
  code         String   @unique
  title        String
  description  String?
  type         String   @default("APARTMENT")
  listingType  String   @default("SALE") // SALE | RENT
  status       String   @default("AVAILABLE")
  price        Float
  area         Float?
  areaUnit     String   @default("sqft")
  bedrooms     Int?
  bathrooms    Int?
  furnishing   String?  // UNFURNISHED | SEMI | FULLY
  address      String?
  locality     String?
  city         String
  amenities    String   @default("")
  images       String   @default("[]") // JSON array of image URLs
  ownerName    String?
  ownerPhone   String?
  featured     Boolean  @default(false)
  published    Boolean  @default(false) // shown on the public website
  latitude     Float?
  longitude    Float?
  agentId      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agent       User?          @relation(fields: [agentId], references: [id], onDelete: SetNull)
  interests   LeadProperty[]
  deals       Deal[]
  followUps   FollowUp[]
  activities  Activity[]
  bookings    Booking[]
  documents   Document[]
  checkIns    SiteVisitCheckIn[]

  @@index([status])
  @@index([city])
}

model LeadProperty {
  leadId     String
  propertyId String
  createdAt  DateTime @default(now())

  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([leadId, propertyId])
}

model FollowUp {
  id           String    @id @default(cuid())
  title        String
  type         String    @default("CALL") // CALL | MEETING | SITE_VISIT | WHATSAPP | EMAIL | OTHER
  dueAt        DateTime
  status       String    @default("PENDING") // PENDING | COMPLETED | CANCELLED
  priority     String    @default("MEDIUM") // HIGH | MEDIUM | LOW
  notes        String?
  outcome      String?
  completedAt  DateTime?
  reminderSentAt DateTime?
  leadId       String
  propertyId   String?
  assignedToId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  lead       Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  assignedTo User?     @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  checkIns   SiteVisitCheckIn[]

  @@index([dueAt])
  @@index([status])
}

model Deal {
  id                String    @id @default(cuid())
  title             String
  value             Float
  commissionPct     Float     @default(2)
  stage             String    @default("NEGOTIATION")
  expectedCloseDate DateTime?
  closedAt          DateTime?
  notes             String?
  leadId            String
  propertyId        String?
  agentId           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  lead       Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  property   Property?  @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  agent      User?      @relation(fields: [agentId], references: [id], onDelete: SetNull)
  activities Activity[]
  booking    Booking?
  documents  Document[]

  @@index([stage])
}

model Activity {
  id         String   @id @default(cuid())
  type       String   // NOTE | CALL | EMAIL | WHATSAPP | STATUS | FOLLOWUP | CREATED | ASSIGNED | DEAL | PROPERTY | MEETING
  content    String
  leadId     String?
  propertyId String?
  dealId     String?
  userId     String?
  createdAt  DateTime @default(now())

  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  deal     Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model WhatsAppTemplate {
  id        String   @id @default(cuid())
  name      String
  category  String   @default("GENERAL") // GREETING | FOLLOW_UP | PROPERTY | SITE_VISIT | GENERAL | FESTIVE
  body      String
  // Approved WhatsApp Business (Meta) template, required to message a lead outside the 24h window
  metaName     String?
  metaLanguage String   @default("en")
  metaParams   String   @default("") // comma separated variable keys in {{1}}, {{2}} order, e.g. "name,property"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WhatsAppMessage {
  id        String   @id @default(cuid())
  phone     String
  body      String
  direction String   @default("OUT") // OUT | IN
  channel   String   @default("LINK") // LINK | API
  status    String   @default("SENT") // SENT | FAILED | OPENED
  error     String?
  waMessageId String?  @unique
  mediaType String?
  leadId    String?
  userId    String?
  createdAt DateTime @default(now())

  lead Lead? @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([leadId, createdAt])
}

model Settings {
  id                 Int      @id @default(1)
  companyName        String   @default("EstateDesk Realty")
  companyPhone       String?
  companyEmail       String?
  companyAddress     String?
  currency           String   @default("INR")
  defaultCountryCode String   @default("91")
  defaultCommission  Float    @default(2)
  waApiEnabled       Boolean  @default(false)
  waPhoneNumberId    String?
  waAccessToken      String?
  leadWebhookKey     String?
  waVerifyToken      String?
  waAppSecret        String?
  waDigestTemplate   String?  // approved Meta template name used for agent daily digest on WhatsApp
  emailDigestEnabled Boolean  @default(true)
  pushEnabled        Boolean  @default(true)
  lastDigestDate     String?  // yyyy-MM-dd of last daily digest run
  // Branding
  logoUrl            String?
  brandColor         String   @default("#4f46e5")
  reraNumber         String?
  // Public website
  websiteEnabled     Boolean  @default(false)
  websiteTagline     String?
  websiteAbout       String?
  // Portal integrations (Facebook / Instagram Lead Ads)
  fbVerifyToken      String?
  fbAppSecret        String?
  fbPageAccessToken  String?
  // Telephony (click-to-call)
  telephonyProvider  String?  // EXOTEL | KNOWLARITY
  exotelSid          String?
  exotelApiKey       String?
  exotelApiToken     String?
  exotelSubdomain    String   @default("api.exotel.com")
  exotelCallerId     String?
  knowlarityApiKey   String?
  knowlarityAuthToken String?
  knowlaritySrNumber String?
  knowlarityCallerId String?
  telephonyWebhookKey String?
  // Attendance
  officeLatitude     Float?
  officeLongitude    Float?
  officeRadiusM      Int      @default(300)
  // Payments
  waPaymentTemplate  String?  // approved Meta template for customer payment reminders
  receiptPrefix      String   @default("RCPT")
  nextReceiptNo      Int      @default(1001)
  updatedAt          DateTime @updatedAt
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginAttempt {
  id        String   @id @default(cuid())
  key       String   // email or ip
  success   Boolean
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model Booking {
  id            String    @id @default(cuid())
  bookingNo     String    @unique
  dealId        String?   @unique
  leadId        String
  propertyId    String?
  unitNumber    String?
  bookingDate   DateTime  @default(now())
  agreementDate DateTime?
  totalAmount   Float
  status        String    @default("ACTIVE") // ACTIVE | COMPLETED | CANCELLED
  notes         String?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  deal         Deal?                @relation(fields: [dealId], references: [id], onDelete: SetNull)
  lead         Lead                 @relation(fields: [leadId], references: [id], onDelete: Cascade)
  property     Property?            @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  createdBy    User?                @relation("BookingCreator", fields: [createdById], references: [id], onDelete: SetNull)
  installments PaymentInstallment[]
  payments     Payment[]
  documents    Document[]

  @@index([leadId])
}

model PaymentInstallment {
  id             String    @id @default(cuid())
  bookingId      String
  label          String    // Token, Agreement (10%), Slab 1 ...
  dueDate        DateTime
  amount         Float
  paidAmount     Float     @default(0) // sum of non-cancelled payments (kept in sync)
  status         String    @default("PENDING") // PENDING | PARTIAL | PAID | WAIVED
  paidAt         DateTime? // date of the latest payment
  notes          String?
  reminderSentAt DateTime?
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  booking  Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([dueDate])
  @@index([status])
}

/// Every amount received gets its own receipt. Receipts are never deleted, only cancelled
/// (with a reason) so the receipt number sequence stays complete for audits.
model Payment {
  id            String    @id @default(cuid())
  receiptNo     String    @unique
  bookingId     String
  installmentId String
  amount        Float
  paidAt        DateTime
  method        String    // UPI | NEFT | RTGS | IMPS | CHEQUE | DD | CASH | CARD | HOME_LOAN | OTHER
  reference     String?   // cheque no / UTR / transaction id
  notes         String?
  status        String    @default("ACTIVE") // ACTIVE | CANCELLED
  cancelledAt   DateTime?
  cancelReason  String?
  cancelledById String?
  recordedById  String?
  createdAt     DateTime  @default(now())

  booking     Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  installment PaymentInstallment @relation(fields: [installmentId], references: [id], onDelete: Cascade)
  recordedBy  User?              @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  cancelledBy User?              @relation("PaymentCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([paidAt])
}

model CallLog {
  id             String    @id @default(cuid())
  direction      String    @default("OUT") // OUT | IN
  status         String    @default("ANSWERED") // INITIATED | RINGING | ANSWERED | MISSED | BUSY | NO_ANSWER | FAILED
  provider       String    @default("MANUAL") // MANUAL | EXOTEL | KNOWLARITY
  providerCallId String?   @unique
  fromNumber     String?
  toNumber       String?
  durationSec    Int       @default(0)
  recordingUrl   String?
  outcome        String?
  notes          String?
  leadId         String?
  userId         String?
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  lead Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([startedAt])
  @@index([leadId])
}

model Attendance {
  id               String    @id @default(cuid())
  userId           String
  date             String    // yyyy-MM-dd in app timezone
  checkInAt        DateTime
  checkInLat       Float?
  checkInLng       Float?
  checkInAccuracy  Float?
  checkInDistanceM Float?
  checkOutAt       DateTime?
  checkOutLat      Float?
  checkOutLng      Float?
  checkOutDistanceM Float?
  notes            String?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
}

model SiteVisitCheckIn {
  id          String   @id @default(cuid())
  leadId      String
  propertyId  String?
  followUpId  String?
  userId      String?
  latitude    Float
  longitude   Float
  accuracy    Float?
  distanceM   Float?   // distance from the property's saved location
  notes       String?
  createdAt   DateTime @default(now())

  lead     Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  followUp FollowUp? @relation(fields: [followUpId], references: [id], onDelete: SetNull)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model Document {
  id                String   @id @default(cuid())
  name              String
  category          String   @default("OTHER") // KYC_PAN | KYC_AADHAAR | KYC_PHOTO | AGREEMENT | SALE_DEED | ALLOTMENT_LETTER | RECEIPT | LOAN | NOC | OTHER
  storagePath       String   // path inside the private documents bucket (or local path in dev)
  mimeType          String
  size              Int
  visibleToCustomer Boolean  @default(false)
  leadId            String?
  dealId            String?
  bookingId         String?
  propertyId        String?
  uploadedById      String?
  createdAt         DateTime @default(now())

  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deal       Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)
  booking    Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  uploadedBy User?     @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([leadId])
}

model PortalAccess {
  id           String    @id @default(cuid())
  leadId       String    @unique
  token        String    @unique // random, shared with the customer as a private link
  pin          String?   // optional 4-6 digit PIN (bcrypt hash)
  lastViewedAt DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model IntegrationLog {
  id        String   @id @default(cuid())
  source    String   // FACEBOOK | INSTAGRAM | 99ACRES | MAGICBRICKS | HOUSING | WEBSITE | EXOTEL | KNOWLARITY
  status    String   // OK | DUPLICATE | ERROR | IGNORED
  message   String?
  payload   String?
  leadId    String?
  createdAt DateTime @default(now())

  @@index([source, createdAt])
}
